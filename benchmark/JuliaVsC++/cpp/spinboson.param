# Thermal independent-boson / spin-boson PT construction.
# Spectral density and mode grid follow Nat. Phys. 2022 SI Sec. S.4.D,
# with the production coupling C/Omega^2 = 0.2 requested for this sweep.
# Frequencies are in units of Omega = 1.

dt                     0.1
te                     8
threshold              1e-8
use_symmetric_Trotter  true
dont_propagate         true
print_timesteps        false

initial                {|0><0|_2}
add_Hamiltonian        {hbar/2.* 1. *(|0><1|_2+|1><0|_2)}

Boson_N_modes          100
Boson_M                5
Boson_J_type           lorentzian
Boson_J_gamma          0.1
Boson_J_scale          0.2
Boson_J_shift          1.0
Boson_omega_min        0
Boson_omega_max        7.5
Boson_sample_range_ends false
temperature_unitless   0.5

add_Output             {|1><1|_2}
outfile                /dev/null
