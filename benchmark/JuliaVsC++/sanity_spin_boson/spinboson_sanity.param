# Small independent-boson ED comparison.
# Published Table S.3.1 keys (dt=0.1, C=0.1, kBT=0.5, M=5, eps=1e-7, Lorentzian)
# at N_E=2 so the 2 * 5^2 = 50 dimensional Hilbert space is exactly diagonalizable.

dt                     0.1
te                     2.0
threshold              1e-7
use_symmetric_Trotter  true
dont_propagate         false
print_timesteps        false
set_precision          17

initial                {|0><0|_2}
add_Hamiltonian        {hbar/2.* 1. *(|0><1|_2+|1><0|_2)}

Boson_N_modes          2
Boson_M                5
Boson_J_type           lorentzian
Boson_J_gamma          0.1
Boson_J_scale          0.1
Boson_J_shift          1.0
Boson_omega_min        0
Boson_omega_max        7.5
Boson_sample_range_ends false
temperature_unitless   0.5

outfile                ACE.out
