!/docs/src/examples/instrument_sequences.md

# Example figures copied from scripts/figures during docs/make.jl
/docs/src/assets/examples/

# Local throwaway project environments at any depth (e.g. .bench_env, .plot_env,
# scripts/.plot_examples_env). Trailing slash limits the match to directories.
.*env/
**/.*env/

# MacOS hidden files
.DS_Store

